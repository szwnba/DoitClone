<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".DoitApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DoitClone">

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.task.TaskDetailActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.organize.OrganizeListActivity" />
        <activity android:name=".ui.organize.OrganizeDetailActivity" />
        <activity android:name=".ui.daily.DailyPlanActivity" />
        <activity android:name=".ui.daily.DailyReviewActivity" />
        <activity android:name=".ui.search.SearchActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.settings.SettingsActivity" />
        <activity
            android:name=".smartadd.SmartAddActivity"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.DoitClone.Translucent"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <receiver android:name=".reminder.ReminderReceiver" android:exported="false" />
        <receiver android:name=".reminder.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
