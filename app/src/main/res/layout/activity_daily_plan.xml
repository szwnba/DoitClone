<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/actionbar_bg"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/daily_plan" 
        app:titleTextColor="@color/actionbar_title_text_color"
        app:theme="@style/ToolbarMenuTheme" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/group_header_bg"
                android:padding="12dp"
                android:text="@string/daily_plan_today"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_planned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/group_header_bg"
                android:padding="12dp"
                android:text="@string/daily_plan_candidates"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_candidates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <Space android:layout_width="match_parent" android:layout_height="32dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
