<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:background="@drawable/task_detail_block_wrap_bg"
            android:layout_margin="16dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:paddingTop="22dp"
                android:paddingRight="16dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/complete_btn"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/complete_checkbox"
                    android:scaleType="center"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="@string/action_complete" />
                <EditText
                    android:id="@+id/title"
                    android:layout_toRightOf="@id/complete_btn"
                    android:textSize="18sp"
                    android:textColor="#D8000000"
                    android:hint="@string/title_hint"
                    android:inputType="text"
                    android:lineSpacingExtra="10dp"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <EditText
                    android:id="@+id/notes"
                    android:layout_toRightOf="@id/complete_btn"
                    android:layout_below="@id/title"
                    android:textSize="16sp"
                    android:textColor="#BF000000"
                    android:paddingTop="28dp"
                    android:hint="@string/description_hint"
                    android:inputType="textMultiLine"
                    android:gravity="top"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/cell_start"
                android:background="@drawable/task_detail_cell_bg_with_bottom_line"
                android:paddingLeft="16dp"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView android:textSize="14sp" android:textColor="#D8000000" android:layout_centerVertical="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/start_time" />
                <TextView android:id="@+id/value_start" android:textSize="14sp" android:textColor="#CC1262A1" android:gravity="center|right" android:paddingRight="16dp" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/cell_estimate"
                android:background="@drawable/task_detail_cell_bg_with_bottom_line"
                android:paddingLeft="16dp"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView android:textSize="14sp" android:textColor="#D8000000" android:layout_centerVertical="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/time_estimated" />
                <TextView android:id="@+id/value_estimate" android:textSize="14sp" android:textColor="#CC1262A1" android:gravity="center|right" android:paddingRight="16dp" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
