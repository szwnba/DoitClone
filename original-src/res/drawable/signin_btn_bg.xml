<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@color/signin_btn_click" />
    <item android:state_focused="true" android:drawable="@color/signin_btn_click" />
    <item android:state_selected="true" android:drawable="@color/signin_btn_click" />
    <item android:state_checked="true" android:drawable="@color/signin_btn_click" />
    <item android:drawable="@color/signin_btn_click" android:state_activated="true" />
