<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@id/subtask_item_wrap" style="@style/subtask_item_wrap"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:id="@id/subtask_complete_btn" android:focusable="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentLeft="true" android:contentDescription="@string/complete" style="@style/subtask_completed" />
    <ImageView android:id="@id/sort_btn" android:background="@android:color/white" android:layout_width="wrap_content" android:layout_height="fill_parent" android:src="@drawable/icon_detailpage_manualsort" android:scaleType="center" android:layout_alignParentRight="true" android:layout_centerVertical="true" />
    <TextView android:id="@id/subtask_title" android:layout_toLeftOf="@id/sort_btn" android:layout_toRightOf="@id/subtask_complete_btn" style="@style/task_detail_subtask_edittext" />
</RelativeLayout>